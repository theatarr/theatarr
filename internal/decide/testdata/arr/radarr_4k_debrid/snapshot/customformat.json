[
 {
  "id": 81,
  "name": "TrueHD ATMOS",
  "includeCustomFormatWhenRenaming": false,
  "specifications": [
   {
    "name": "TrueHD",
    "implementation": "ReleaseTitleSpecification",
    "negate": false,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "True[ .-]?HD|W4NK3R|HQMUX"
     }
    ]
   },
   {
    "name": "ATMOS",
    "implementation": "ReleaseTitleSpecification",
    "negate": false,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "\\b(ATMOS|CtrlHD|W4NK3R|HQMUX|DON|3L)(\\b|\\d)"
     }
    ]
   },
   {
    "name": "Not Basic Dolby Digital",
    "implementation": "ReleaseTitleSpecification",
    "negate": true,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "\\bDD[^a-z+]|(?<!e-)\\b(ac-?3)\\b"
     }
    ]
   },
   {
    "name": "Not Dolby Digital Plus",
    "implementation": "ReleaseTitleSpecification",
    "negate": true,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "\\bDD[P+]|\\b(e[-_. ]?ac-?3)\\b"
     }
    ]
   },
   {
    "name": "Not DTS",
    "implementation": "ReleaseTitleSpecification",
    "negate": true,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "\\bDTS(\\b|\\d)"
     }
    ]
   },
   {
    "name": "Not DTS X",
    "implementation": "ReleaseTitleSpecification",
    "negate": true,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "\\b(dts[-_.: ]?x7?)\\b(?![-_. ]?(26[456]))"
     }
    ]
   },
   {
    "name": "Not FLAC",
    "implementation": "ReleaseTitleSpecification",
    "negate": true,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "\\bFLAC(\\b|\\d)"
     }
    ]
   },
   {
    "name": "Not 5.1 Surround",
    "implementation": "ReleaseTitleSpecification",
    "negate": true,
    "required": true,
    "fields": [
     {
      "name": "value",
      "value": "[^0-9]5[ .][0-1]\\b"
     }
    ]
   }
  ]
 },
 {
  "id": 93,
  "name": "HDR",
